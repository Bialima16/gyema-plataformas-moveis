<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/auth_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/model_bg_welcome" tools:context=".LoginActivity">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/model_bg_pattern" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="32dp" android:paddingTop="48dp" android:paddingBottom="40dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.22" android:text="@string/model_login_welcome" android:textColor="@color/model_muted" android:textSize="12sp" />
            <ImageView android:layout_width="160dp" android:layout_height="160dp" android:layout_marginTop="20dp" android:contentDescription="@string/model_brand_description" android:src="@drawable/model_ic_gyema" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/model_brand" android:textColor="@color/model_white" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/model_bg_badge" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:text="@string/model_academy" android:textColor="@color/model_muted" android:textSize="10sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:letterSpacing="0.06" android:text="@string/model_login" android:textColor="@color/model_orange_text" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:lineSpacingExtra="4dp" android:text="@string/model_login_description" android:textColor="@color/model_muted" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/login_email" android:text="@string/model_email_label" android:textColor="@color/model_color_9c8bbb" android:textSize="14sp" android:textStyle="bold" />
            <EditText android:id="@+id/login_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:autofillHints="emailAddress" android:background="@drawable/model_bg_login_field" android:drawableStart="@drawable/model_ic_email" android:drawablePadding="12dp" android:fontFamily="sans-serif" android:hint="@string/model_email_hint" android:imeOptions="actionNext" android:inputType="textEmailAddress" android:paddingHorizontal="12dp" android:singleLine="true" android:textAppearance="@style/model_TextAppearance_Gyema" android:textColor="@color/model_white" android:textColorHint="@color/model_color_b3a9cd" android:textSize="12sp" android:minHeight="52dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:labelFor="@id/login_password" android:text="@string/model_password_label" android:textColor="@color/model_color_9c8bbb" android:textSize="14sp" android:textStyle="bold" />
                <Button android:id="@+id/login_forgot" style="@style/model_WelcomeFooter" android:text="@string/model_forgot_password" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/model_bg_login_field" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp">
                <EditText android:id="@+id/login_password" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:drawableStart="@drawable/model_ic_lock" android:drawablePadding="12dp" android:fontFamily="sans-serif" android:hint="@string/model_password_hint" android:imeOptions="actionDone" android:inputType="textPassword" android:paddingVertical="0dp" android:saveEnabled="false" android:singleLine="true" android:textAppearance="@style/model_TextAppearance_Gyema" android:textColor="@color/model_white" android:textColorHint="@color/model_color_b3a9cd" android:textSize="12sp" android:importantForAutofill="no" />
                <ImageButton android:id="@+id/login_toggle_password" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/model_show_password" android:padding="14dp" android:src="@drawable/model_ic_eye_off" />
            </LinearLayout>
            <CheckBox android:id="@+id/login_remember" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="@color/model_color_ada0ba" android:fontFamily="sans-serif" android:text="@string/model_remember_user" android:textAppearance="@style/model_TextAppearance_Gyema" android:textColor="@color/model_color_ada0ba" android:textSize="11sp" android:minHeight="48dp" />
            <Button android:id="@+id/login_submit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/model_bg_login_button" android:backgroundTint="@null" android:drawableEnd="@drawable/model_ic_arrow" android:drawableTint="@color/model_muted" android:paddingHorizontal="32dp" android:stateListAnimator="@null" android:text="@string/model_login" android:textAllCaps="false" android:textColor="@color/model_muted" android:textSize="16sp" android:minHeight="58dp" />
            <Button android:id="@+id/login_register" style="@style/model_WelcomeFooter" android:layout_marginTop="4dp" android:text="@string/model_no_account" android:textColor="@color/model_color_ada0ba" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
    <ImageButton android:id="@+id/auth_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_marginTop="4dp" android:background="@drawable/model_bg_back" android:padding="12dp" android:src="@drawable/model_ic_back" android:contentDescription="@string/model_back" />
</FrameLayout>
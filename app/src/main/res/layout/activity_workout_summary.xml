<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ns1="http://schemas.android.com/tools" android:id="@+id/workout_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/workout_navy" ns1:context=".WorkoutSummaryActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:importantForAccessibility="no" android:src="@drawable/workout_check" />
        <TextView style="@style/WorkoutText" android:text="@string/workout_complete" android:gravity="center" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="12dp" />
        <TextView style="@style/WorkoutText" android:text="@string/workout_name" android:gravity="center" android:textStyle="bold" android:layout_marginTop="8dp" />
        <TextView style="@style/WorkoutText" android:text="@string/workout_date" android:gravity="center" android:textColor="@color/workout_muted" />
        <TextView style="@style/WorkoutText" android:text="@string/workout_sets" android:layout_marginTop="20dp" android:padding="12dp" android:drawableStart="@drawable/workout_medal" android:drawablePadding="8dp" android:background="@drawable/workout_sets" android:textColor="@color/workout_orange" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:layout_marginTop="8dp" android:padding="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/workout_card">
            <TextView style="@style/WorkoutText" android:text="@string/workout_supino" android:layout_width="0dp" android:layout_weight="1" android:textStyle="bold" />
            <TextView style="@style/WorkoutText" android:text="@string/workout_supino_stats" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/workout_muted" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:layout_marginTop="8dp" android:padding="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/workout_card">
            <TextView style="@style/WorkoutText" android:text="@string/workout_inclinado" android:layout_width="0dp" android:layout_weight="1" android:textStyle="bold" />
            <TextView style="@style/WorkoutText" android:text="@string/workout_inclinado_stats" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/workout_muted" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:layout_marginTop="8dp" android:padding="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/workout_card">
            <TextView style="@style/WorkoutText" android:text="@string/workout_crucifixo" android:layout_width="0dp" android:layout_weight="1" android:textStyle="bold" />
            <TextView style="@style/WorkoutText" android:text="@string/workout_crucifixo_stats" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/workout_muted" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:layout_marginTop="8dp" android:padding="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/workout_card">
            <TextView style="@style/WorkoutText" android:text="@string/workout_crossover" android:layout_width="0dp" android:layout_weight="1" android:textStyle="bold" />
            <TextView style="@style/WorkoutText" android:text="@string/workout_crossover_stats" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/workout_muted" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:layout_marginTop="8dp" android:padding="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/workout_card">
            <TextView style="@style/WorkoutText" android:text="@string/workout_corda" android:layout_width="0dp" android:layout_weight="1" android:textStyle="bold" />
            <TextView style="@style/WorkoutText" android:text="@string/workout_corda_stats" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/workout_muted" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:layout_marginTop="8dp" android:padding="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/workout_card">
            <TextView style="@style/WorkoutText" android:text="@string/workout_frances" android:layout_width="0dp" android:layout_weight="1" android:textStyle="bold" />
            <TextView style="@style/WorkoutText" android:text="@string/workout_frances_stats" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/workout_muted" android:textSize="13sp" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="36dp" android:layout_weight="1" />
        <Button android:id="@+id/workout_return" style="@style/WorkoutButton" android:text="@string/workout_return" />
    </LinearLayout>
</ScrollView>
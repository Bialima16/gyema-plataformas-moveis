<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ns1="http://schemas.android.com/tools" android:id="@+id/workout_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/workout_navy" ns1:context=".EquipmentOccupiedActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <ImageButton android:id="@+id/workout_back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/workout_card" android:padding="14dp" android:src="@drawable/model_ic_back" android:contentDescription="@string/workout_back" />
        <Space android:layout_width="1dp" android:layout_height="100dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/workout_card" android:padding="24dp">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center_horizontal" android:importantForAccessibility="no" android:src="@drawable/workout_warning" />
            <TextView style="@style/WorkoutText" android:text="@string/workout_occupied_title" android:gravity="center" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="24dp" />
            <TextView style="@style/WorkoutText" android:text="@string/workout_occupied_message" android:gravity="center" android:textColor="@color/workout_muted" android:layout_marginTop="10dp" android:lineSpacingExtra="4dp" />
            <Button android:id="@+id/equipment_reorder" style="@style/WorkoutButton" android:text="@string/workout_reorder" android:layout_marginTop="24dp" />
            <Button android:id="@+id/equipment_keep" style="@style/WorkoutButton" android:text="@string/workout_keep_order" android:layout_marginTop="12dp" android:background="@drawable/workout_outlined" android:textColor="@color/workout_orange" />
            <Button android:id="@+id/equipment_alternatives" style="@style/WorkoutButton" android:text="@string/workout_alternatives" android:layout_marginTop="16dp" android:background="@android:color/transparent" android:textColor="@color/workout_orange" android:textSize="13sp" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="100dp" android:layout_weight="1" />
    </LinearLayout>
</ScrollView>
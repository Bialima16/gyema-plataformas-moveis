<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="Theme.Gyema" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Gyema.Auth" parent="Theme.Gyema">
        <item name="android:colorAccent">@color/auth_orange</item>
        <item name="android:windowBackground">@color/auth_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/auth_navy</item>
        <item name="android:navigationBarColor">@color/auth_navy</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:textViewStyle">@style/model_Widget_Gyema_TextView</item>
        <item name="android:buttonStyle">@style/model_Widget_Gyema_Button</item>
        <item name="android:textAppearance">@style/model_TextAppearance_Gyema</item>
        <item name="android:textAppearanceButton">@style/model_TextAppearance_Gyema</item>
    </style>
    <style name="AuthText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/auth_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="AuthButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/auth_navy</item>
        <item name="android:backgroundTint">@color/auth_orange</item>
    </style>
    <style name="AuthLink" parent="AuthButton">
        <item name="android:textColor">@color/auth_white</item>
        <item name="android:backgroundTint">@color/auth_purple</item>
    </style>
    <style name="AuthField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/auth_white</item>
        <item name="android:textColorHint">@color/auth_muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:background">@drawable/auth_field</item>
    </style>
</resources>